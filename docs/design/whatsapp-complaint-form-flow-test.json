{
  "version": "6.2",
  "screens": [
    {
      "id": "COMPLAINT",
      "title": "Raise a complaint",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextInput",
            "name": "location",
            "label": "Tower and flat",
            "input-type": "text",
            "helper-text": "For example T5-901",
            "required": true
          },
          {
            "type": "TextArea",
            "name": "problem",
            "label": "What is the problem?",
            "helper-text": "For example Leakage in bathroom",
            "required": true
          },
          {
            "type": "Dropdown",
            "name": "category",
            "label": "Category",
            "required": true,
            "data-source": [
              { "id": "mygate", "title": "MyGate" },
              { "id": "fire_safety", "title": "Fire Safety" },
              { "id": "lift", "title": "Lift issues" },
              { "id": "housekeeping", "title": "Housekeeping" },
              { "id": "security", "title": "Security, CCTV and Park+" },
              { "id": "cultural", "title": "Cultural Committee" },
              { "id": "finance", "title": "Finance" },
              { "id": "common", "title": "Clubhouse and open areas" },
              { "id": "legal", "title": "Legal" },
              { "id": "plumbing", "title": "Plumbing" },
              { "id": "other", "title": "Something else" }
            ]
          },
          {
            "type": "RadioButtonsGroup",
            "name": "priority",
            "label": "How urgent is it?",
            "required": true,
            "data-source": [
              { "id": "urgent", "title": "Urgent" },
              { "id": "high", "title": "High" },
              { "id": "medium", "title": "Medium" },
              { "id": "low", "title": "Low" }
            ]
          },
          {
            "type": "Footer",
            "label": "Submit",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "location": "${form.location}",
                "problem": "${form.problem}",
                "category": "${form.category}",
                "priority": "${form.priority}"
              }
            }
          }
        ]
      }
    }
  ]
}
