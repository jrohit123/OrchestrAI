 },
 {
  "kind": "block",
  "name": "Tell the person who has the case (old, unused)",
  "gates": [],
  "steps": [
   {
    "op": "resolve_entity",
    "when": {
     "field": "$case.assigned_to_id",
     "exists": true
    },
    "params": {
     "into": "handler",
     "table": "users",
     "name_from": "$case.assigned_to_id",
     "match_column": "id"
    }
   },
   {
    "op": "notify.user",
    "when": {
     "and": [
      {
       "field": "$handler.phone",
       "exists": true
      },
      {
       "field": "$handler.phone",
       "not_equals": "$user.phone"
      },
      {
       "field": "$handler.phone",
       "not_equals": "$requester.phone"
      }
     ]
    },
    "params": {
     "to": "$handler.phone",
     "message_template": "ℹ️ Case {case_case_number} ({case_title}) {tell_prefix} {tell_text}"
    }
   }
  ],
  "version": 1,
  "settings": {},
  "is_active": true,
  "intent_key": "case_tell_handler",
  "description": "Sends the person the case is with now a message, unless they are the one acting. Give it tell_prefix and tell_text.",
  "menu_section": "other",
  "entity_schema": {
   "tell_text": {
    "type": "string",
    "required": true,
    "description": "The rest of the message, for example a closing note."
   },
   "tell_prefix": {
    "type": "string",
    "required": true,
    "description": "The words after the case number and title, for example 'was closed.'"
   }
  },
  "workflow_type": "action",
  "response_format": "generic",
  "training_phrases": []
 },
 {
  "kind": "block",
  "name": "Tell everyone on the case",
  "gates": [],
  "steps": [
   {
    "op": "notify.parties",
    "when": {
     "field": "$fields.tell_buttons",
     "equals": "yes"
    },
    "params": {
     "case": "$case",
     "buttons": {
      "✅ Close": "/close {case_case_number}",
      "👤 Pass on": "/assign {case_case_number}",
      "📝 Add update": "/update {case_case_number}"
     },
     "with_photos": true,
     "role_templates": {
      "assignee": "$fields.tell_message_assignee"
     },
     "message_template": "$fields.tell_message"
    }
   },
   {
    "op": "notify.parties",
    "when": {
     "field": "$fields.tell_buttons",
     "not_equals": "yes"
    },
    "params": {
     "case": "$case",
     "with_photos": true,
     "role_templates": {
      "assignee": "$fields.tell_message_assignee"
     },
     "message_template": "$fields.tell_message"
    }
   }
  ],
  "version": 1,
  "settings": {},
  "is_active": true,
  "intent_key": "case_tell_parties",
