  "entity_schema": {
   "case_number": {
    "type": "string",
    "label": "Case",
    "read_by": {
     "lookup": {
      "show": [
       "case_number",
       "title"
      ],
      "table": "cases",
      "normalize": "identifier",
      "match_column": "case_number"
     }
    },
    "question": "Which case? Send the case number, for example CS-26-08-00017.",
    "required": true,
    "description": "The case number, for example CS-26-08-00017. Any format is accepted."
