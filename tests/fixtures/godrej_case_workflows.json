  "intent_key": "case_pass_on",
  "description": "Gives a case to one person, keeps an optional note, and tells everyone on the case.",
  "menu_section": "other",
  "entity_schema": {
   "case_number": {
    "type": "string",
    "label": "Case",
    "read_by": {
     "lookup": {
      "show": [
       "case_number",
       "title"
