[
 {
  "kind": "workflow",
  "name": "Add an update to a case",
  "gates": [],
  "steps": [
   {
    "op": "run_workflow",
    "params": {
     "workflow": "case_find"
    }
   },
   {
    "op": "run_workflow",
    "params": {
     "workflow": "case_comment"
    }
   },
   {
    "op": "case.attach_photos",
    "params": {
     "case_id": "$case.id"
    }
   },
   {
    "op": "run_workflow",
    "params": {
     "inputs": {
      "tell_buttons": "yes",
      "tell_message": "📝 Case {case_case_number} ({case_title}): update from {actor_name}\n{comment_text}"
