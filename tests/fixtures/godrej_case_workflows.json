 {
  "kind": "workflow",
  "name": "Assign a case",
  "gates": [],
  "steps": [
   {
    "op": "run_workflow",
    "params": {
     "workflow": "case_find"
    }
   },
   {
    "op": "case.add_parties",
    "when": {
     "field": "$case.assigned_to_id",
     "exists": true
    },
    "params": {
     "role": "helper",
     "case_id": "$case.id",
     "users_from": "$case.assigned_to_id"
    }
   },
   {
    "op": "run_workflow",
    "params": {
     "workflow": "case_assign"
    }
   },
   {
    "op": "run_workflow",
