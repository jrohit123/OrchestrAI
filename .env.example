# ── ROUTING DATABASE ─────────────────────────────────────
ROUTING_DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# ── REDIS ─────────────────────────────────────────────
REDIS_URL=redis://user:password@host:port

# ── OPENAI ─────────────────────────────────────────────
OPENAI_API_KEY=CHANGE_ME

# ── GEMINI (primary LLM, free tier) ───────────────────
GEMINI_API_KEY=CHANGE_ME
GEMINI_API_KEY_2=CHANGE_ME
GEMINI_API_KEY_3=CHANGE_ME

# ── GROQ (fallback LLM, free tier) ────────────────────
GROQ_API_KEY=CHANGE_ME

# ── CEREBRAS (fallback LLM) ────────────────────────────
CEREBRAS_API_KEY=CHANGE_ME

# ── META WHATSAPP CLOUD API ───────────────────────────
WHATSAPP_TOKEN=CHANGE_ME
WHATSAPP_PHONE_ID=CHANGE_ME
WHATSAPP_VERIFY_TOKEN=CHANGE_ME
WHATSAPP_APP_SECRET=CHANGE_ME

# ── TELEGRAM BOT (for Telegram channel orgs) ──────────
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME

# ── BREVO (OTP emails) ────────────────────────────────
BREVO_API_KEY=CHANGE_ME

# ── ADMIN ─────────────────────────────────────────────
ADMIN_TOKEN=CHANGE_ME

# ── APP ───────────────────────────────────────────────
APP_ENV=development
